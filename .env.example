# Copia este archivo a .env o configura las variables en Railway / IntelliJ.
# Desarrollo local (MySQL en tu PC, base cletaeats_db.sql):
MYSQLHOST=localhost
MYSQLPORT=3306
MYSQLDATABASE=cletaeats
MYSQLUSER=root
MYSQLPASSWORD=tu_contraseña_mysql

# Railway (se inyectan automáticamente al vincular el servicio MySQL):
# MYSQLHOST=...
# MYSQLPORT=...
# MYSQLDATABASE=railway
# MYSQLUSER=...
# MYSQLPASSWORD=...

# Alternativa Render / legacy:
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=cletaeats
# DB_USER=root
# DB_PASSWORD=tu_contraseña
